# Copy to .env.local and enter your local PostgreSQL password.
LOCAL_TEST_MODE=1
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=livingatlas_test
DB_USER=postgres
DB_PASSWORD=replace-with-local-password
DB_SSLMODE=disable

# Optional description drafting through a locally configured Atlas Helper.
# ATLAS_HELPER_URL=http://127.0.0.1:8001
# Set ATLAS_DESCRIPTION_TOKEN to the same random token in both services.
